{
  "name": "harusoso-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "node scripts/generate-site-images.js && node scripts/generate-post-images.js && node scripts/generate-index-page.js && node scripts/generate-post-pages.js && node scripts/generate-static-pages.js && node scripts/generate-sitemap.js",
    "validate:seo": "node scripts/validate-seo.js",
    "seed": "node scripts/generate-seed-posts.js",
    "crawl:plan": "node scripts/crawl-curation.js --dry-run",
    "image:generate": "node scripts/generate-post-images.js",
    "image:site": "node scripts/generate-site-images.js",
    "image:fetch": "node scripts/fetch-r2-image.js",
    "image:upload": "node scripts/upload-r2-image.js"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0"
  }
}
